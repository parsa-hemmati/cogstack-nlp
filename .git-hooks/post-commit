#!/bin/bash
#
# POST-COMMIT HOOK - Autonomous Development Orchestration
# Triggered: After every successful commit
# Purpose: Spawn auditor agent to check PRD compliance and update AUDIT.md
#
# Flow:
#   1. Commit succeeds → This hook runs
#   2. Spawn auditor agent (async, in background)
#   3. Auditor updates AUDIT.md with compliance score + blocking todos
#   4. If blocking todos exist → Development agent auto-triggered on next commit attempt
#   5. Loop continues until AUDIT.md shows ✅ CLEAR

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo -e "${BLUE}   POST-COMMIT HOOK: Autonomous Development Orchestration${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo ""

# Get commit hash and message
COMMIT_HASH=$(git rev-parse HEAD)
COMMIT_MSG=$(git log -1 --pretty=%B)
COMMIT_SHORT=$(git log -1 --pretty=format:"%h - %s")

echo -e "${GREEN}✅ Commit successful:${NC} $COMMIT_SHORT"
echo ""

# ============================================================================
# CONFIGURATION
# ============================================================================

# Check if autonomous mode is enabled
AUTONOMOUS_CONFIG=".claude/autonomous-config.yaml"
if [ -f "$AUTONOMOUS_CONFIG" ]; then
    # Extract enabled flag from YAML (simple grep, not full YAML parser)
    AUTONOMOUS_ENABLED=$(grep "^  enabled:" "$AUTONOMOUS_CONFIG" | awk '{print $2}')

    if [ "$AUTONOMOUS_ENABLED" != "true" ]; then
        echo -e "${YELLOW}⏸️  Autonomous mode disabled in $AUTONOMOUS_CONFIG${NC}"
        echo -e "${YELLOW}   Skipping auditor agent spawn${NC}"
        echo ""
        exit 0
    fi
else
    echo -e "${YELLOW}⚠️  No autonomous config found at $AUTONOMOUS_CONFIG${NC}"
    echo -e "${YELLOW}   Skipping auditor agent spawn${NC}"
    echo ""
    exit 0
fi

# ============================================================================
# STEP 1: Check if this is a merge commit (skip auditor for merges)
# ============================================================================

MERGE_COMMIT=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || echo "")
if [ -n "$MERGE_COMMIT" ]; then
    echo -e "${YELLOW}⏭️  Merge commit detected, skipping auditor${NC}"
    echo ""
    exit 0
fi

# ============================================================================
# STEP 2: Check if this commit already has audit results
# ============================================================================

# Check if AUDIT.md was updated in this commit
AUDIT_UPDATED=$(git diff-tree --no-commit-id --name-only -r HEAD | grep "AUDIT.md" || echo "")

if [ -n "$AUDIT_UPDATED" ]; then
    echo -e "${GREEN}✅ AUDIT.md already updated in this commit${NC}"
    echo -e "${GREEN}   (Auditor ran during development, skipping post-commit audit)${NC}"
    echo ""

    # Check if AUDIT.md shows CLEAR status
    if grep -q "Commit Status: ✅ CLEAR" AUDIT.md; then
        echo -e "${GREEN}🎉 AUDIT.md status: ✅ CLEAR${NC}"
        echo -e "${GREEN}   No blocking issues, ready for next task${NC}"
        echo ""

        # Trigger next task loader (if configured)
        if [ -f ".git-hooks/load-next-task.sh" ]; then
            echo -e "${BLUE}🔄 Loading next task...${NC}"
            bash .git-hooks/load-next-task.sh
        fi
    else
        echo -e "${YELLOW}⚠️  AUDIT.md has blocking issues${NC}"
        echo -e "${YELLOW}   Development agent will auto-fix on next commit attempt${NC}"
        echo ""
    fi

    exit 0
fi

# ============================================================================
# STEP 3: Spawn auditor agent (background process)
# ============================================================================

echo -e "${BLUE}🔍 Spawning auditor agent to check PRD compliance...${NC}"
echo ""

# Create auditor agent prompt
AUDITOR_PROMPT="# Auditor Agent - Post-Commit Review

**Trigger**: Post-commit hook for commit $COMMIT_HASH
**Commit**: $COMMIT_SHORT

## Your Task

You are an **auditor agent** triggered automatically after a commit. Your job is to:

1. **Review the commit** against PRD specifications
2. **Check for PRD compliance** (field names, types, structure, endpoints)
3. **Detect breaking changes** (API contract violations)
4. **Update AUDIT.md** with:
   - Compliance score (0-100%)
   - Commit Status (✅ CLEAR or 🚨 BLOCKING)
   - List of issues found (if any)
   - Blocking todos for development agent to fix

## What to Check

### Files Changed in This Commit
\`\`\`
$(git diff-tree --no-commit-id --name-only -r HEAD)
\`\`\`

### Diff Summary
\`\`\`
$(git show --stat HEAD)
\`\`\`

### Check Against PRD
- Read relevant PRD specification from \`.specify/specifications/\`
- Compare implementation against PRD:
  - Endpoint paths match?
  - Field names match (camelCase vs snake_case)?
  - Request/response structure match?
  - HTTP status codes match?
  - Authentication requirements match?

### Detect Breaking Changes
- Endpoint path changes (breaks frontend)
- Field name changes (breaks API contract)
- Field type changes (breaks serialization)
- Structure changes (nested → flat or vice versa)
- Required → optional changes (or vice versa)

## AUDIT.md Update Format

Update \`AUDIT.md\` with this structure:

\`\`\`markdown
## 🎯 Current Compliance Status

### Commit Status: [✅ CLEAR or 🚨 BLOCKING]

**Last Audit**: $(date +%Y-%m-%d)
**Commit**: $COMMIT_SHORT

[If CLEAR:]
**All checks passed** - No issues found

[If BLOCKING:]
**Blocking Issues Found** - $N issues requiring fixes

#### Blocking Todos (Development Agent will auto-fix these):
- [ ] **TODO-1**: [Issue description]
  - **File**: [file path:line number]
  - **Expected**: [what PRD says]
  - **Actual**: [what code has]
  - **Fix**: [how to fix it]

- [ ] **TODO-2**: ...

**Action**: Development agent will be triggered on next commit attempt to fix these issues.

---

### Overall Score: [X%] Compliant

[Rest of AUDIT.md content...]
\`\`\`

## Exit Behavior

After updating AUDIT.md:

1. **If compliance = 100%** (✅ CLEAR):
   - No action needed
   - System ready for next task

2. **If compliance < 100%** (🚨 BLOCKING):
   - Create blocking todos in AUDIT.md
   - Pre-commit hook will trigger development agent to fix
   - Development agent will commit fixes
   - Post-commit hook will re-run auditor (verify fixed)
   - Loop continues until ✅ CLEAR

## Important Notes

- Be thorough but fast (this runs after every commit)
- Focus on breaking changes (high priority)
- Minor issues are warnings, not blockers
- Update AUDIT.md only (don't commit anything)
- Exit after updating AUDIT.md

Begin audit now."

# Save prompt to temp file
AUDITOR_PROMPT_FILE=".git-hooks/tmp/auditor-prompt-$COMMIT_HASH.txt"
mkdir -p .git-hooks/tmp
echo "$AUDITOR_PROMPT" > "$AUDITOR_PROMPT_FILE"

# Spawn auditor agent in background (non-blocking)
echo -e "${BLUE}📝 Auditor prompt saved to: $AUDITOR_PROMPT_FILE${NC}"
echo -e "${BLUE}🚀 Triggering auditor agent (background process)...${NC}"
echo ""

# NOTE: In actual implementation, this would spawn Claude Code agent
# For now, we log the action
echo -e "${YELLOW}⚠️  MANUAL STEP REQUIRED:${NC}"
echo -e "${YELLOW}   Copy the prompt from: $AUDITOR_PROMPT_FILE${NC}"
echo -e "${YELLOW}   Paste into Claude Code session${NC}"
echo -e "${YELLOW}   Auditor will update AUDIT.md with compliance results${NC}"
echo ""

# Future: Integrate with Claude Code CLI/API when available
# claude-code agent spawn --prompt-file "$AUDITOR_PROMPT_FILE" --background

# ============================================================================
# STEP 4: Log event
# ============================================================================

LOG_FILE=".git-hooks/autonomous.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') [POST-COMMIT] Commit: $COMMIT_SHORT | Auditor: Spawned" >> "$LOG_FILE"

echo -e "${GREEN}✅ Post-commit hook complete${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo ""

exit 0
