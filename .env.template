# Environment Configuration Template for Clinical Care Tools
# Version: 1.0.0
# Copy this file to .env and fill in secure values
#
# IMPORTANT: Never commit .env to version control (it's in .gitignore)
#
# Security Requirements:
# - All passwords must be ≥16 characters
# - JWT secrets must be ≥32 bytes (64 hex characters)
# - Encryption keys must be exactly 32 bytes (base64 encoded)
# - Rotate all secrets every 90 days (HIPAA requirement)

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
POSTGRES_USER=clinicaltools
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_MIN_16_CHARS
POSTGRES_DB=clinical_care_tools
POSTGRES_PORT=5432

# Generate secure password:
# openssl rand -base64 32

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_MIN_16_CHARS
REDIS_PORT=6379

# Generate secure password:
# openssl rand -base64 32

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_MIN_64_HEX_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Generate JWT secret (256-bit):
# openssl rand -hex 64

# =============================================================================
# Encryption (for PHI at rest)
# =============================================================================
ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_BASE64_KEY

# Generate encryption key (256-bit AES):
# openssl rand -base64 32

# =============================================================================
# CogStack-ModelServe Configuration
# =============================================================================
MODELSERVE_PORT=8001
MODELSERVE_LOG_LEVEL=INFO
MODELSERVE_WORKERS=4

# Authentication (set to 'true' for production)
MODELSERVE_ENABLE_AUTH=false
MODELSERVE_API_KEY=

# If ENABLE_AUTH=true, generate API key:
# openssl rand -hex 32

# =============================================================================
# Backend API Configuration
# =============================================================================
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=false  # Set to 'true' only for local development

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:8080,http://frontend:8080

# Audit Logging Retention
AUDIT_LOG_RETENTION_DAYS=2920  # 8 years (NHS Data Security and Protection Toolkit)

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10  # Maximum document size in MB
ALLOWED_DOCUMENT_TYPES=.rtf,.txt,.docx,.pdf

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=8080

# API URL (accessible from browser)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# Application Versions (for Docker builds)
# =============================================================================
PYTHON_VERSION=3.10
NODE_VERSION=18

# User IDs (for running containers as non-root)
UID=1000
GID=1000

# =============================================================================
# Security Checklist
# =============================================================================
# Before using this .env file in production:
#
# [✓] All passwords are ≥16 characters
# [✓] JWT_SECRET_KEY is ≥64 hex characters (256-bit)
# [✓] ENCRYPTION_KEY is exactly 32 bytes (base64 encoded)
# [✓] All "CHANGE_ME" values have been replaced
# [✓] .env file has restricted permissions (chmod 600 .env)
# [✓] .env file is listed in .gitignore (never commit secrets!)
# [✓] Secrets are unique per environment (dev/staging/production)
# [✓] Secret rotation schedule documented (every 90 days)
#
# HIPAA Compliance:
# - Access Control (164.312(a)(1)): Unique user identification ✓
# - Audit Controls (164.312(b)): All PHI access logged ✓
# - Integrity (164.312(c)(1)): SHA-256 hashing for authentication ✓
# - Transmission Security (164.312(e)(1)): TLS 1.3 required (add Nginx)
#
# GDPR Compliance:
# - Data Minimization (Article 5(1)(c)): Only necessary PHI collected ✓
# - Security (Article 32): Encryption at rest (AES-256) and in transit (TLS 1.3) ✓
# - Audit Trail: All data access logged with retention (8 years) ✓
#
# =============================================================================
# Quick Start Commands
# =============================================================================
#
# 1. Copy this template:
#    cp .env.template .env
#
# 2. Generate secure secrets:
#    echo "POSTGRES_PASSWORD=$(openssl rand -base64 32)" >> .env
#    echo "REDIS_PASSWORD=$(openssl rand -base64 32)" >> .env
#    echo "JWT_SECRET_KEY=$(openssl rand -hex 64)" >> .env
#    echo "ENCRYPTION_KEY=$(openssl rand -base64 32)" >> .env
#
# 3. Edit .env and verify all values
#
# 4. Set restrictive permissions:
#    chmod 600 .env
#
# 5. Verify configuration:
#    docker-compose config
#
# 6. Start services:
#    docker-compose up -d
#
# =============================================================================
