# Clinical Care Tools - Environment Configuration
# Copy this file to .env and configure for your environment
#
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Database Settings
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_to_strong_password
POSTGRES_DB=clinical_care_tools
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Test database (for running tests)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinical_care_tools_test

# =============================================================================
# Redis Settings
# =============================================================================
REDIS_PASSWORD=changeme_to_strong_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# =============================================================================
# JWT / Authentication
# =============================================================================
# CRITICAL: Generate a strong secret key for production!
# Use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-256-bit-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS Settings
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# =============================================================================
# CogStack ModelServe (NLP)
# =============================================================================
MODELSERVE_URL=http://cogstack-modelserve:8000
MODELS_PATH=./models

# =============================================================================
# Frontend Settings
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Clinical Care Tools
NODE_ENV=development

# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
# Sentry for error tracking (leave empty to disable)
SENTRY_DSN=

# =============================================================================
# Email Settings (for alerts & reports)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# =============================================================================
# Encryption (for PHI at rest)
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =============================================================================
# Healthcare Compliance
# =============================================================================
# Data retention period in years (NHS: 8 years minimum)
DATA_RETENTION_YEARS=8

# Audit log retention in days
AUDIT_LOG_RETENTION_DAYS=2555  # ~7 years

# =============================================================================
# Production-Only Settings
# =============================================================================
# SSL/TLS Certificate paths (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=30
