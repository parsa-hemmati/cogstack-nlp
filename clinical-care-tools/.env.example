# Clinical Care Tools - Environment Configuration Template
# Version: 1.0.0
# Purpose: Template for environment variables (DO NOT commit sensitive values)
# Usage: Copy to .env.development or .env.production and fill in values

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Deployment environment (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

# Database URL: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://clinical_admin:changeme@postgres:5432/clinical_care_tools

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# ============================================================================
# REDIS (Cache & Session Store)
# ============================================================================

# Redis URL
REDIS_URL=redis://redis:6379/0

# Redis password (set in production)
REDIS_PASSWORD=

# Cache TTL in seconds (1 hour)
REDIS_CACHE_TTL=3600

# ============================================================================
# COGSTACK MODELSERVE (NLP Service)
# ============================================================================

# MedCAT Service URL
COGSTACK_MODELSERVE_URL=http://cogstack-modelserve:8001

# MedCAT timeout in seconds
COGSTACK_TIMEOUT=30

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Secret key for signing JWT tokens (CHANGE IN PRODUCTION!)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=development-secret-key-change-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_DAYS=7

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ============================================================================
# AUDIT & COMPLIANCE
# ============================================================================

# Audit log retention (days) - 7 years = 2555 days (NHS requirement)
AUDIT_LOG_RETENTION_DAYS=2555

# Audit log file path (in container)
AUDIT_LOG_PATH=/var/log/audit

# ============================================================================
# LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=info

# ============================================================================
# APPLICATION
# ============================================================================

# Number of worker processes (2-4 per CPU core)
WORKERS=4

# ============================================================================
# DATABASE USERS (for docker-compose)
# ============================================================================

# PostgreSQL admin user
POSTGRES_USER=clinical_admin

# PostgreSQL admin password (CHANGE IN PRODUCTION!)
POSTGRES_PASSWORD=changeme

# PostgreSQL database name
POSTGRES_DB=clinical_care_tools

# ============================================================================
# SSL/TLS (Production Only)
# ============================================================================

# Enable SSL/TLS
SSL_ENABLED=false

# SSL certificate path (inside container)
SSL_CERT_PATH=/etc/ssl/certs/clinical-care-tools.crt

# SSL private key path (inside container)
SSL_KEY_PATH=/etc/ssl/private/clinical-care-tools.key

# ============================================================================
# FRONTEND (Vue.js)
# ============================================================================

# API base URL (for frontend)
VITE_API_BASE_URL=http://localhost:8000

# Application title
VITE_APP_TITLE=Clinical Care Tools

# Frontend environment
VITE_ENVIRONMENT=development

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ============================================================================
# OPTIONAL: EMAIL (for future features)
# ============================================================================

# SMTP server
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinical-care-tools.local

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================

# Sentry (error tracking)
SENTRY_DSN=

# DataDog (monitoring)
DATADOG_API_KEY=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable debug mode (NEVER in production)
DEBUG=false

# Reload on code changes (development only)
RELOAD=true

# ============================================================================
# NOTES
# ============================================================================

# IMPORTANT:
# 1. Never commit .env files with real credentials to git
# 2. Each environment should have its own .env file (.env.development, .env.production)
# 3. Use strong, random values for all SECRET_* and *_PASSWORD variables
# 4. For production, ensure:
#    - SSL_ENABLED=true
#    - ENVIRONMENT=production
#    - LOG_LEVEL=info
#    - DEBUG=false
#    - Strong unique passwords for all services
# 5. Rotate secrets regularly (every 90 days)
# 6. Store secrets securely (AWS Secrets Manager, HashiCorp Vault, etc.)

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================

# Before deploying to production, verify:
# [ ] SECRET_KEY is changed from default
# [ ] POSTGRES_PASSWORD is changed from default
# [ ] REDIS_PASSWORD is set (if exposed)
# [ ] CORS_ORIGINS is restricted to your domain
# [ ] SSL_ENABLED=true
# [ ] ENVIRONMENT=production
# [ ] All passwords are 12+ characters with mixed case, numbers, symbols
# [ ] JWT_EXPIRATION_HOURS is set appropriately (8 hours recommended)
# [ ] AUDIT_LOG_RETENTION_DAYS is set (2555 for healthcare)
# [ ] BACKUP_RETENTION_DAYS is set appropriately (30 days minimum)
