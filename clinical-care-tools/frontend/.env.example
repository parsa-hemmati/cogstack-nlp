# Application Configuration
VITE_APP_TITLE=Clinical Care Tools
VITE_APP_VERSION=0.1.0

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN_KEY=cct_auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=cct_refresh_token
VITE_AUTH_SESSION_TIMEOUT=3600000

# Feature Flags
VITE_FEATURE_PATIENT_SEARCH=true
VITE_FEATURE_TIMELINE_VIEW=true
VITE_FEATURE_FHIR_EXPORT=false

# Environment
VITE_ENV=development
VITE_DEBUG=true

# MedCAT Service
VITE_MEDCAT_SERVICE_URL=http://localhost:5000

# Security
VITE_ENABLE_CSP=true
VITE_MAX_FILE_SIZE=52428800