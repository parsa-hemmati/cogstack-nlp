# Application Environment
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=development-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - Web Environment (Native PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinical_care_tools

# Redis - Web Environment (Native Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Optional

# CogStack-ModelServe - Web Environment (Mocked)
# Production: Point to actual CogStack-ModelServe service
MEDCAT_SERVICE_URL=http://localhost:8001
# MEDCAT_API_KEY=  # Optional

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=logs/audit.log

# Session Management
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=5

# File Storage
FILE_STORAGE_BACKEND=postgresql
MAX_FILE_SIZE_MB=50

# Data Retention (NHS requirement: 8 years)
DATA_RETENTION_YEARS=8

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]
