# Application Configuration
APP_NAME=Clinical Care Tools
APP_VERSION=0.1.0
DEBUG=false
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://clinical_admin:changeme@localhost:5432/clinical_care_tools
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for PHI)
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_ALGORITHM=AES-256

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# MedCAT Service
MEDCAT_SERVICE_URL=http://localhost:5000
MEDCAT_SERVICE_TIMEOUT=60

# Audit & Compliance
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=2555
LOG_LEVEL=INFO

# Modules
ENABLED_MODULES=patient-search,timeline,cds,cohort

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=*
