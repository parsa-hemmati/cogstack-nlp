# Clinical Care Tools - Environment Configuration Template
# Copy this file to .env and update values for your environment
#
# SECURITY WARNING: Never commit .env files with real credentials to git!
# Generate secure values using the commands below.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=postgres
# IMPORTANT: Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=clinical_care_tools
# SSL Mode: 'prefer' for local dev, 'require' for production
DATABASE_SSL_MODE=prefer

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# MEDCAT MODEL PATHS
# =============================================================================
# Path to directory containing MedCAT models (relative to project root)
MODELS_PATH=./models

# =============================================================================
# JWT AUTHENTICATION (REQUIRED)
# =============================================================================
# SECURITY: Generate a secure random key - REQUIRED, no defaults!
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_KEY_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# ENCRYPTION KEY (REQUIRED FOR PHI)
# =============================================================================
# AES-256 encryption key for PHI at rest - HIPAA compliance requirement
# Generate: openssl rand -base64 32
# WARNING: Losing this key means permanent loss of encrypted PHI data!
# See docs/security/ENCRYPTION_KEY_MANAGEMENT.md for backup procedures
ENCRYPTION_KEY=REPLACE_WITH_AES256_KEY_USE_OPENSSL_RAND_BASE64_32

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL (for frontend)
VITE_API_BASE_URL=http://localhost:8000

# CogStack-ModelServe URL (internal to Docker network)
MODELSERVE_URL=http://cogstack-modelserve:8000

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=30

# Maximum failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# AUDIT LOGGING
# =============================================================================
# Enable audit logging for HIPAA compliance
AUDIT_LOG_ENABLED=true

# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=2920

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis connection pool settings
REDIS_POOL_SIZE=10
REDIS_POOL_MAX_SIZE=20

# CogStack-ModelServe workers
MODELSERVE_WORKERS=2

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_FHIR_EXPORT=false
ENABLE_CLINICAL_DECISION_SUPPORT=false
ENABLE_BREAK_GLASS_ACCESS=true

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Node environment for frontend
NODE_ENV=development

# Backend workers (for production)
BACKEND_WORKERS=4
