# Clinical Care Tools - Production Environment Configuration
# Version: 1.0.0
# Purpose: Production environment template
# *** CHANGE ALL VALUES BEFORE DEPLOYING ***

# ============================================================================
# ENVIRONMENT
# ============================================================================

ENVIRONMENT=production

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

# Use strong, random password
# Generate with: openssl rand -base64 32
DATABASE_URL=postgresql://clinical_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/clinical_care_tools

DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_RECYCLE=3600

# ============================================================================
# REDIS
# ============================================================================

REDIS_URL=redis://redis:6379/0

# Use strong password
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_CACHE_TTL=3600

# ============================================================================
# COGSTACK MODELSERVE (NLP Service)
# ============================================================================

COGSTACK_MODELSERVE_URL=http://cogstack-modelserve:8001
COGSTACK_TIMEOUT=30

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Use strong, unique secret key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_WITH_STRONG_RANDOM_KEY_32_CHARACTERS_MIN

JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_DAYS=7

# ============================================================================
# CORS
# ============================================================================

# Restrict to your production domain only
# Example: https://clinical.healthcare.org
CORS_ORIGINS=https://clinical.healthcare.org,https://www.clinical.healthcare.org

# ============================================================================
# AUDIT & COMPLIANCE
# ============================================================================

# 7 years retention (NHS requirement for clinical records)
AUDIT_LOG_RETENTION_DAYS=2555

AUDIT_LOG_PATH=/var/log/audit

# ============================================================================
# LOGGING
# ============================================================================

# Use 'info' or 'warning' in production (not 'debug')
LOG_LEVEL=info

# ============================================================================
# APPLICATION
# ============================================================================

# Increase for production (2-4 per CPU core, e.g., 8-16 for 4-core CPU)
WORKERS=8

# ============================================================================
# DATABASE USERS
# ============================================================================

# Use strong, unique password
# Generate with: openssl rand -base64 32
POSTGRES_USER=clinical_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=clinical_care_tools

# ============================================================================
# SSL/TLS (REQUIRED FOR PRODUCTION)
# ============================================================================

SSL_ENABLED=true

# Path to your SSL certificate
SSL_CERT_PATH=/etc/ssl/certs/clinical-care-tools.crt

# Path to your SSL private key
SSL_KEY_PATH=/etc/ssl/private/clinical-care-tools.key

# ============================================================================
# FRONTEND
# ============================================================================

# Must be your production domain
VITE_API_BASE_URL=https://clinical.healthcare.org/api

VITE_APP_TITLE=Clinical Care Tools

VITE_ENVIRONMENT=production

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================

# Keep 30 days of backups minimum
BACKUP_RETENTION_DAYS=30

# ============================================================================
# EMAIL (Optional)
# ============================================================================

SMTP_HOST=smtp.healthcare-org.local
SMTP_PORT=587
SMTP_USER=noreply@healthcare-org.local
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=Clinical Care Tools <noreply@healthcare-org.local>

# ============================================================================
# MONITORING (Optional)
# ============================================================================

# Sentry for error tracking
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# DataDog for monitoring
DATADOG_API_KEY=

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# NEVER enable debug mode in production
DEBUG=false

# Never enable hot reload in production
RELOAD=false

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================

# 1. Generate secure values:
#    a) Database password: openssl rand -base64 32
#    b) Redis password: openssl rand -base64 32
#    c) Secret key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Replace all CHANGE_ME_* values with actual secure values
#
# 3. Verify SSL certificates exist:
#    - /etc/ssl/certs/clinical-care-tools.crt
#    - /etc/ssl/private/clinical-care-tools.key
#
# 4. Set restrictive file permissions:
#    - chmod 600 .env.production
#    - chown clinical-care:clinical-care .env.production
#
# 5. Deploy:
#    - docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#    - ./scripts/health-check.sh
#
# 6. Verify security:
#    - Test HTTPS connection: openssl s_client -connect clinical.healthcare.org:443
#    - Check security headers: curl -I https://clinical.healthcare.org
#    - Verify authentication works
#    - Check audit logs
#
# 7. Monitor:
#    - docker-compose logs -f backend
#    - ./scripts/health-check.sh
#    - Check disk space: df -h
#    - Check backups running: ls -la backups/

# ============================================================================
# SECURITY CHECKLIST (BEFORE GOING LIVE)
# ============================================================================

# [ ] All CHANGE_ME_* values replaced with secure, unique values
# [ ] SECRET_KEY is at least 32 characters
# [ ] POSTGRES_PASSWORD is strong (12+ chars, mixed case, numbers, symbols)
# [ ] REDIS_PASSWORD is strong
# [ ] CORS_ORIGINS restricted to production domain only
# [ ] SSL_ENABLED=true
# [ ] SSL certificates obtained and verified
# [ ] ENVIRONMENT=production
# [ ] DEBUG=false
# [ ] RELOAD=false
# [ ] LOG_LEVEL=info (not debug)
# [ ] WORKERS set appropriately for server CPU count
# [ ] Database backups configured and tested
# [ ] Monitoring and alerting configured
# [ ] Firewall rules configured (allow HTTPS/443, block other ports)
# [ ] Default admin credentials will be changed immediately after deployment
# [ ] Incident response plan documented
# [ ] Staff trained on security policies
# [ ] Regular security updates scheduled
# [ ] Penetration testing planned
# [ ] Compliance requirements verified (HIPAA, GDPR, etc.)

# ============================================================================
# COMPLIANCE NOTES
# ============================================================================

# HIPAA Requirements:
# - Encryption in transit: TLS 1.3 ✓ (SSL_ENABLED=true)
# - Encryption at rest: Database should use encrypted filesystem
# - Access controls: RBAC implemented in application
# - Audit logging: All access logged (AUDIT_LOG_RETENTION_DAYS=2555)
# - Data integrity: Database ACID compliance ✓
#
# GDPR Requirements:
# - Lawful basis: Ensure you have consent/legal basis
# - Data minimization: Only collect necessary data ✓
# - Right to access: API endpoint available
# - Right to erasure: Database deletion available
# - Data retention: Set AUDIT_LOG_RETENTION_DAYS appropriately
# - Breach notification: Plan documented
#
# 21 CFR Part 11 (FDA):
# - Electronic records: Database ✓
# - User authentication: JWT + passwords ✓
# - Audit trails: Comprehensive logging ✓
# - System validation: Testing required
# - Change control: Documentation required
