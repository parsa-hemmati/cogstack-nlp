# =============================================================================
# Test Environment Configuration
# =============================================================================
# This file configures an isolated test environment with different ports
# to avoid conflicts with development services.
#
# Usage:
#   1. Copy this file or use directly: export $(cat .env.test | xargs)
#   2. Run tests: ./scripts/docker-test-runner.sh run
# =============================================================================

# Database (PostgreSQL) - Test Instance
POSTGRES_USER=test_clinicaltools
POSTGRES_PASSWORD=test_secure_password_for_testing_only
POSTGRES_DB=clinical_care_tools_test
POSTGRES_PORT=5433

# Redis - Test Instance
REDIS_PASSWORD=test_redis_password_for_testing_only
REDIS_PORT=6380

# Elasticsearch - Test Instance
ELASTICSEARCH_PORT=9201

# MedCAT Service - Test Instance
MEDCAT_PORT=8002

# Backend API - Test Instance
BACKEND_PORT=8001
BACKEND_LOG_LEVEL=DEBUG
ENVIRONMENT=test
DEBUG=true

# Frontend - Test Instance
FRONTEND_PORT=8081
VITE_API_BASE_URL=http://localhost:8001/api/v1

# JWT Authentication (Test Keys - DO NOT USE IN PRODUCTION)
JWT_SECRET_KEY=test_jwt_secret_key_for_testing_purposes_only_minimum_64_characters_required
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=1

# Encryption Key (Test Key - DO NOT USE IN PRODUCTION)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS (Allow test frontend)
CORS_ORIGINS=["http://localhost:8081"]

# Audit Logging (shorter retention for tests)
AUDIT_LOG_RETENTION_DAYS=7
MAX_UPLOAD_SIZE_MB=5

# Search Indexer Configuration (faster for tests)
SEARCH_BATCH_INTERVAL_MINUTES=1
SEARCH_BATCH_SIZE=100

# Application Versions
PYTHON_VERSION=3.11
NODE_VERSION=18

# User IDs (for container permissions)
UID=1000
GID=1000

# =============================================================================
# Browser-use AI Testing Configuration
# =============================================================================

# Anthropic API Key (required for browser-use tests)
# Set this in your actual environment, not committed to git
# ANTHROPIC_API_KEY=sk-ant-...

# Browser-use settings
BROWSER_USE_MODEL=claude-sonnet-4-20250514
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Test patient for E2E tests
TEST_PATIENT_ID=patient-test-001
FRONTEND_URL=http://localhost:8081
API_BASE_URL=http://localhost:8001
