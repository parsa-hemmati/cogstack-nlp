# Test Environment Configuration (for unit/integration tests)
# Minimal configuration for running tests without real services

# Database (dummy values for testing)
DATABASE_URL=postgresql://test:test@localhost:5432/test_db

# Redis (dummy values for testing)
REDIS_URL=redis://localhost:6379/0

# JWT (test key - NOT for production)
JWT_SECRET_KEY=test_secret_key_for_unit_tests_only_not_for_production_use_minimum_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Encryption (test key - NOT for production)
ENCRYPTION_KEY=dGVzdF9lbmNyeXB0aW9uX2tleV8zMl9ieXRl  # base64 encoded "test_encryption_key_32_byte"

# Environment
ENVIRONMENT=test
DEBUG=true

# CORS (permissive for testing)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Audit logging
AUDIT_LOG_RETENTION_DAYS=30

# File uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=.rtf,.txt,.docx,.pdf

# Meditech (mock values for testing)
MEDITECH_CLIENT_ID=test_client_id
MEDITECH_CLIENT_SECRET=test_client_secret
MEDITECH_TOKEN_URL=https://test.meditech.example/oauth2/token
MEDITECH_FHIR_BASE_URL=https://test.meditech.example/fhir/r4
USE_MOCK_FHIR=true
